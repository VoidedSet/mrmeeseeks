# Mr Meeseeks - Git Ignore Rules

# Python-specific ignores
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Model files & weights
models/
*.safetensors
*.gguf
*.bin
*.pt
*.ckpt

# Output, logging, and caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
logs/outputs/
logs/raw/
*.log

# Keep the finetune dataset but ignore other files in logs
# logs/
# !logs/finetune/
# Memory cache files
memory/store/*.json
!memory/store/hello.json
!memory/store/last_interaction.json
!memory/store/what_can_you_do_.json

# Operating System specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
.project
.pydevproject
.settings/

# Supermemory local runtime
.supermemory/
