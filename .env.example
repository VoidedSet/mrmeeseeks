# ── LLM Backend ──────────────────────────────────────────────────────────────
# Which backend to use: groq | ollama
LLM_BACKEND=groq

# Model to use. Per-backend defaults:
#   groq  → llama-3.1-8b-instant  (closest free equivalent to Qwen3:3b)
#   ollama → qwen2.5:3b
LLM_MODEL=llama-3.1-8b-instant

# ── Groq ─────────────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: override Groq base URL (e.g. for a proxy)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Ollama (when it comes back) ───────────────────────────────────────────────
# To switch back: set LLM_BACKEND=ollama, LLM_MODEL=qwen3:3b
# OLLAMA_URL=http://localhost:11434

# ── Notes on Qwen3 return ────────────────────────────────────────────────────
# If Qwen3 emits <tool_call> XML instead of raw JSON, set QWEN_MODE=1
# (not yet implemented — add to llm_provider.py when needed)
# QWEN_MODE=0

# ── Ollama Web Search ──────────────────────────────
# Get free API key from: https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here

# ── Email (Gmail IMAP) ────────────────────────────
# Enable IMAP in Gmail settings + generate 16-char App Password
# (Google Account > Security > 2-Step Verification > App passwords)
EMAIL_PROVIDER=gmail
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ── Morning Brief ─────────────────────────────────
WEATHER_CITY=Delhi
# Comma-separated news interests for morning brief
USER_INTERESTS=football,Barca,Messi,tech,AI,geopolitics,India
# Minutes of inactivity before triggering morning brief on re-open
BRIEF_TRIGGER_MINUTES=30
